#!/bin/sh
# First-boot defaults for the TP-Link Deco X55 v3 community build.
# Runs on every first boot of a new image (also after a config-preserving sysupgrade), so every
# step only touches values that are still at OpenWrt's defaults - user settings are never changed.

[ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = "tplink,deco-x55-v3" ] || exit 0

# --- root password: only if none is set yet --------------------------------------------------------
if grep -qE '^root::' /etc/shadow 2>/dev/null; then
	printf 'deco-modded\ndeco-modded\n' | passwd root >/dev/null 2>&1
fi

# --- Wi-Fi offload (WED): module option, active from the next boot (/etc/modules.conf is ubox's) ---
grep -q 'mt7915e.*wed_enable' /etc/modules.conf 2>/dev/null || \
	printf '# MediaTek WED: hardware offload of Wi-Fi <-> Ethernet forwarding\noptions mt7915e wed_enable=Y\n' >> /etc/modules.conf

# --- once per installation (marker survives config-preserving upgrades) ---------------------------
[ "$(uci -q get system.@system[0].deco_defaults)" = "1" ] && exit 0

# regulatory country: the unit's own value from factory_data (as the stock firmware uses it)
country=$(sed -n 's/^country:\([A-Z][A-Z]\).*/\1/p' /tmp/factory_data/product-info 2>/dev/null | head -1)

# Every value is only changed while it is still OpenWrt's own default (as generated by the Wi-Fi
# detection), so upgrades from other builds never alter a configured system.
for r in $(uci show wireless | sed -n "s/^wireless\.\([^.]*\)=wifi-device$/\1/p"); do
	c=$(uci -q get wireless.$r.country)
	[ -n "$country" ] && { [ -z "$c" ] || [ "$c" = "00" ]; } && uci set wireless.$r.country="$country"
	ch=$(uci -q get wireless.$r.channel); hm=$(uci -q get wireless.$r.htmode)
	case "$(uci -q get wireless.$r.band)" in
	5g) [ "$ch" = "36" ] && [ "$hm" = "HE80" ] && { uci set wireless.$r.channel='44'; uci set wireless.$r.htmode='HE160'; } ;;   # like stock
	2g) [ "$ch" = "1" ] && [ "$hm" = "HE20" ] && { uci set wireless.$r.channel='auto'; uci set wireless.$r.htmode='HE40'; } ;;
	esac
done
# same network name on both bands (band steering by usteer), 802.11k/v, PMF; Wi-Fi stays disabled
# until the user configures it (standard OpenWrt behaviour)
for i in $(uci show wireless | sed -n "s/^wireless\.\([^.]*\)=wifi-iface$/\1/p"); do
	[ "$(uci -q get wireless.$i.mode)" = "ap" ] || continue
	[ "$(uci -q get wireless.$i.ssid)" = "OpenWrt" ] || continue
	uci set wireless.$i.ssid='Deco-OpenWrt'
	uci -q get wireless.$i.ieee80211k >/dev/null || uci set wireless.$i.ieee80211k='1'
	uci -q get wireless.$i.bss_transition >/dev/null || uci set wireless.$i.bss_transition='1'
	uci -q get wireless.$i.ieee80211w >/dev/null || uci set wireless.$i.ieee80211w='1'
done
uci commit wireless

# hardware flow offloading (PPE)
uci -q get firewall.@defaults[0].flow_offloading >/dev/null || {
	uci set firewall.@defaults[0].flow_offloading='1'
	uci set firewall.@defaults[0].flow_offloading_hw='1'
	uci commit firewall
}

[ "$(uci -q get system.@system[0].hostname)" = "OpenWrt" ] && uci set system.@system[0].hostname='Deco-X55'
uci set system.@system[0].deco_defaults='1'
uci commit system
exit 0
